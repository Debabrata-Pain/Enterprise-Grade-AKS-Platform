module "acr_private_endpoint" {

  source = "../../modules/private-endpoint"

  name = "${var.environment}-acr-pe"

  location = var.location

  resource_group_name = module.shared_rg.resource_group_name

  subnet_id = module.private_endpoint_subnet.id

  resource_id = module.acr.id

  private_dns_zone_id = module.acr_private_dns.id

  subresource_names = [
    "registry"
  ]

  tags = local.common_tags

}